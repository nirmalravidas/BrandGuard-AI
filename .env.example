# Local Docker Compose only. Use separate, secret values in hosted environments.
DATABASE_USERNAME=replace-with-database-username
DATABASE_PASSWORD=replace-with-a-local-only-password
FRONTEND_PORT=8081
FRONTEND_ORIGIN=http://localhost:8081

# Optional. Leave blank for clearly labelled rules-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions

# Local Compose defaults to the backend service on the private Compose network.
# For a separately hosted frontend, set this to the backend's public HTTPS URL.
BACKEND_URL=http://backend:8080
